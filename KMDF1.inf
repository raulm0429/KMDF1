;
; KMDF1.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = KMDF1.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
KMDF1.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%KMDF1.DeviceDesc% = KMDF1_Device, Root\KMDF1 ; TODO: edit hw-id

[KMDF1_Device.NT]
CopyFiles = File_Copy

[File_Copy]
KMDF1.sys

;-------------- Service installation
[KMDF1_Device.NT.Services]
AddService = KMDF1,%SPSVCINST_ASSOCSERVICE%, KMDF1_Service_Inst

; -------------- KMDF1 driver install sections
[KMDF1_Service_Inst]
DisplayName    = %KMDF1.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\KMDF1.sys

[KMDF1_Device.NT.Wdf]
KmdfService = KMDF1, KMDF1_wdfsect

[KMDF1_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "KMDF1 Installation Disk"
KMDF1.DeviceDesc = "KMDF1 Device"
KMDF1.SVCDESC = "KMDF1 Service"
